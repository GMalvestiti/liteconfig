{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${contact_homepage}",
    "sources": "${contact_sources}",
    "issues": "${contact_issues}"
  },
  "license": "${license}",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
        "com.gmalvestiti.minecraft.liteconfig.platform.fabric.FabricEntrypoint"
    ],
    "client": [
        "com.gmalvestiti.minecraft.liteconfig.platform.fabric.FabricClientEntrypoint"
    ]
  },
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": ">=${fabric_api}"
  }
}
